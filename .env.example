APP_NAME="MRTI Exams Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

CLIENT_URL=http://localhost:5173

JWT_SECRET=change-me-in-production
JWT_EXPIRY=4h

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=exams_portal_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Face Biometrics — enrollment/verification/monitoring face-matching is computed
# client-side; this service is used only for the AWS Rekognition liveness flow.
FACE_SERVICE_URL=http://localhost:5001
FACE_ENCRYPTION_KEY=
FACE_VERIFICATION_THRESHOLD=0.50
FACE_MONITORING_INTERVAL=60
FACE_MAX_WARNINGS=5
FACE_REFERENCE_SIMILARITY_THRESHOLD=90
FACE_LIVENESS_THRESHOLD=75
AUDIO_NOISE_THRESHOLD=-50
AUDIO_MAX_WARNINGS=2

# Telegram (error alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seed admin account (php artisan db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin123

# CI/CD deploy webhook secret (POST /api/deploy/callback as Bearer token).
# Generate with: php artisan tinker --execute="echo Str::random(40);"
DEPLOY_TOKEN=
